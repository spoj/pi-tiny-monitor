{
  "name": "pi-tiny-monitor",
  "version": "0.1.0",
  "description": "Minimal background process monitor with stdout and exit wake-ups for Pi",
  "type": "module",
  "keywords": ["pi-package"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3",
    "typebox": "^1.3.7",
    "vitest": "^4.1.9"
  }
}
